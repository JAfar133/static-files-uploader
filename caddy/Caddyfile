# Внутренний Caddy Static Hub. Адрес сайта задаёт переменная SITE_ADDRESS:
#   static-hub.example.com  — самостоятельный режим: Caddy сам выпускает HTTPS-сертификат (порты 80/443);
#   :80                     — режим за общим (edge) Caddy: обычный HTTP внутри docker-сети, TLS делает edge.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Публичная статика: /public/static/<проект>/...
	handle_path /public/static/* {
		root * /sites/static
		header Cache-Control "no-cache"
		file_server
	}

	# Админка и API — под паролем
	handle {
		basic_auth {
			{$ADMIN_USER} {$ADMIN_PASS_HASH}
		}
		request_body {
			max_size 1GB
		}
		handle /api/* {
			reverse_proxy hub-api:3000
		}
		handle {
			root * /srv/app
			try_files {path} /index.html
			file_server
		}
	}
}
